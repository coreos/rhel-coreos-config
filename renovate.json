{
  "description": [
    "Renovate configuration for RHEL CoreOS",
    "Automatically updates bootc base container images for CentOS Stream and RHEL builds",
    "Scheduled on Sunday mornings (00:00-12:00 UTC)"
  ],
  "ignorePaths": [
    "fedora-coreos-config"
  ],
  "dependencyDashboard": true,
  "automerge": true,
  "automergeType": "branch",
  "platformAutomerge": true,
  "enabledManagers": [
    "custom.regex",
    "tekton"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "tekton": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ],
    "includePaths": [
      ".tekton/**"
    ],
    "packageRules": [
      {
        "matchPackageNames": [
          "/^quay.io/bootc-devel/tekton-catalog//"
        ],
        "enabled": true,
        "versioning": "semver-coerced",
        "groupName": "Konflux references",
        "branchPrefix": "konflux/references/",
        "additionalBranchPrefix": "",
        "group": {
          "branchTopic": "{{{baseBranch}}}",
          "commitMessageTopic": "{{{groupName}}}"
        },
        "commitMessageTopic": "Konflux references",
        "recreateWhen": "always",
        "rebaseWhen": "behind-base-branch",
        "platformAutomerge": true,
        "automerge": true,
        "addLabels": [
          "lgtm"
        ],
      }
    ],
    "schedule": [
      "* 0-4 * * *"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Update 'BUILDER_IMG' in build-args conf files"
      ],
      "managerFilePatterns": [
        "/build-args.*\\.conf$/"
      ],
      "matchStrings": [
        "BUILDER_IMG=(?<depName>.*):(?<currentValue>.*)@(?<currentDigest>.*)\\n"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "addLabels": [
        "lgtm"
      ],
      "matchPackageNames": [
        "/quay.io/centos-bootc/centos-bootc/"
      ],
      "matchFileNames": [
        "build-args-c10s.conf"
      ],
      "groupName": "bootc base container images",
      "groupSlug": "bootc-{{baseBranch}}-updates",
      "branchPrefix": "mintmaker-",
      "additionalBranchPrefix": "",
      "schedule": [
        "* 0-12 * * 0"
      ],
      "recreateWhen": "always",
      "rebaseWhen": "always"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "addLabels": [
        "lgtm"
      ],
      "matchPackageNames": [
        "/quay.io/centos-bootc/centos-bootc/"
      ],
      "matchFileNames": [
        "build-args-c9s.conf"
      ],
      "groupName": "bootc base container images",
      "groupSlug": "bootc-{{baseBranch}}-updates",
      "branchPrefix": "mintmaker-",
      "additionalBranchPrefix": "",
      "schedule": [
        "* 0-12 * * 0"
      ],
      "recreateWhen": "always",
      "rebaseWhen": "always"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "addLabels": [
        "lgtm"
      ],
      "matchPackageNames": [
        "/registry.stage.redhat.io/rhel10/rhel-bootc.*/"
      ],
      "matchFileNames": [
        "build-args-rhel-10.*\\.conf"
      ],
      "allowedVersions": "/^10\\.2/",
      "groupName": "bootc base container images",
      "groupSlug": "bootc-{{baseBranch}}-updates",
      "branchPrefix": "mintmaker-",
      "additionalBranchPrefix": "",
      "schedule": [
        "* 0-12 * * 0"
      ],
      "recreateWhen": "always",
      "rebaseWhen": "always"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "addLabels": [
        "lgtm"
      ],
      "matchPackageNames": [
        "/registry.stage.redhat.io/rhel9/rhel-bootc.*/"
      ],
      "matchFileNames": [
        "build-args-rhel-9.*\\.conf"
      ],
      "allowedVersions": "/^9\\.8/",
      "groupName": "bootc base container images",
      "groupSlug": "bootc-{{baseBranch}}-updates",
      "branchPrefix": "mintmaker-",
      "additionalBranchPrefix": "",
      "schedule": [
        "* 0-12 * * 0"
      ],
      "recreateWhen": "always",
      "rebaseWhen": "always"
    }
  ]
}
