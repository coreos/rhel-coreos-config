# This builds the OCP4NV nodeimage/baseimage on top of the nodeimage/baseimage itself.
ARG FROM
FROM ${FROM}

ARG VERSION
ARG NAME=overridden
ARG STREAM=overridden
ARG DESCRIPTION=overridden
ARG MAINTAINER=overridden
ARG URL=overridden
ARG DISTRIBUTION_SCOPE=overridden
ARG COMPONENT=overridden
ARG CPE_NAME=overridden

# FIXME: use the value below once we move the container build to Konflux
#COPY voyager.repo  /etc/yum.repos.d/
COPY off-layering/nvidia/voyager.repo  /etc/yum.repos.d/

RUN <<EOF

if [ -n "$VERSION" ]; then
    OLD_VERSION=$(grep "^OSTREE_VERSION=" /usr/lib/os-release | cut -d"'" -f2)
    [ -n "$OLD_VERSION" ] || { echo "Error: Could not extract version from os-release"; exit 1; }
    sed -i "s|$OLD_VERSION|$VERSION|g" /usr/lib/os-release
fi

cat /usr/lib/os-release
echo $VERSION

arch="$(uname -m)"
dnf remove kernel-core --assumeyes

kernel_name='kernel-core kernel-modules-extra'
[ "$arch" = 'aarch64' ] && kernel_name='kernel-64k-core kernel-64k-modules-extra'

dnf install --assumeyes --disablerepo=* --enablerepo=voyager $kernel_name

kver=$(ls /usr/lib/modules)
env DRACUT_NO_XATTR=1 dracut -vf /usr/lib/modules/$kver/initramfs.img "$kver"
EOF

LABEL org.opencontainers.image.version=$VERSION \
      com.coreos.osname=$NAME \
      name=$NAME \
      com.coreos.stream=$STREAM \
      org.opencontainers.image.title=$DESCRIPTION \
      org.opencontainers.image.description=$DESCRIPTION \
      io.k8s.description=$DESCRIPTION \
      description=$DESCRIPTION \
      com.redhat.component=$COMPONENT \
      cpe=$CPE_NAME
